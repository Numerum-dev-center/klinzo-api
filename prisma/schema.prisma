generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN_SAAS
  GESTIONNAIRE_SAAS
  SUPPORT_SAAS
  ADMIN_COLLECTEUR
  AGENT_COLLECTEUR
  USAGER
}

model User {
  id                         BigInt          @id @default(autoincrement())
  trackingId                 String          @unique @default(uuid())
  createdAt                  DateTime        @default(now())
  updatedAt                  DateTime        @updatedAt
  firstName                  String
  lastName                   String
  email                      String          @unique
  emailVerified              Boolean         @default(false)
  emailVerificationCodeHash  String?
  emailVerificationExpiresAt DateTime?
  emailVerificationSentAt    DateTime?
  emailVerificationAttempts  Int             @default(0)
  passwordResetCodeHash      String?
  passwordResetExpiresAt     DateTime?
  passwordResetSentAt        DateTime?
  passwordResetAttempts      Int             @default(0)
  sessionVersion             Int             @default(0)
  phone                      String
  password                   String
  hashedRefreshToken         String?
  role                       Role            @default(USAGER)
  isActive                   Boolean         @default(true)
  collectorId                BigInt?
  collector                  Collector?      @relation(fields: [collectorId], references: [id])
  subscriptions              Subscription[]
  ratings                    Rating[]
  pickupRequests             PickupRequest[]
}

enum KycStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum CollectorType {
  INDIVIDUAL
  COMPANY
  MUNICIPALITY
  ASSOCIATION
}

enum CollectorApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model CollectorApplication {
  id                  BigInt                     @id @default(autoincrement())
  trackingId          String                     @unique @default(uuid())
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  companyName         String
  registrationNumber  String
  type                CollectorType
  adresse             String
  firstName           String
  lastName            String
  contactEmail        String
  contactPhone        String
  status              CollectorApplicationStatus @default(PENDING)
  rejectionReason     String?
  collectorTrackingId String?
  userTrackingId      String?
  inviteTokenHash     String?                    @unique
  inviteExpiresAt     DateTime?
  invitedAt           DateTime?
  activatedAt         DateTime?

  @@index([status, createdAt])
  @@index([contactEmail])
}

model Vehicle {
  id           BigInt    @id @default(autoincrement())
  trackingId   String    @unique @default(uuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  matricule    String    @unique
  licensePlate String
  type         String
  capacity     Int
  isActive     Boolean   @default(true)
  collectorId  BigInt
  collector    Collector @relation(fields: [collectorId], references: [id])
  tours        Tour[]
}

model Zone {
  id             BigInt                                  @id @default(autoincrement())
  trackingId     String                                  @unique @default(uuid())
  createdAt      DateTime                                @default(now())
  updatedAt      DateTime                                @updatedAt
  name           String
  city           String?
  polygonPostgis Unsupported("geometry(Polygon, 4326)")?
  isActive       Boolean                                 @default(true)
  collectorZones CollectorZone[]
  offers         Offer[]
}

model CollectorZone {
  collectorId BigInt
  zoneId      BigInt
  collector   Collector @relation(fields: [collectorId], references: [id])
  zone        Zone      @relation(fields: [zoneId], references: [id])
  assignedAt  DateTime  @default(now())

  @@id([collectorId, zoneId])
}

model Offer {
  id            BigInt         @id @default(autoincrement())
  trackingId    String         @unique @default(uuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  name          String
  price         Float
  frequency     String
  wasteType     String
  isActive      Boolean        @default(true)
  collectorId   BigInt
  collector     Collector      @relation(fields: [collectorId], references: [id])
  zoneId        BigInt
  zone          Zone           @relation(fields: [zoneId], references: [id])
  subscriptions Subscription[]
}

model Collector {
  id                 BigInt              @id @default(autoincrement())
  trackingId         String              @unique @default(uuid())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  companyName        String
  registrationNumber String
  contactEmail       String
  contactPhone       String
  type               CollectorType
  adresse            String
  kycStatus          KycStatus           @default(PENDING_REVIEW)
  ratingAverage      Float               @default(0.0)
  payoutAccount      String?
  isActive           Boolean             @default(true)
  users              User[]
  vehicles           Vehicle[]
  collectorZones     CollectorZone[]
  offers             Offer[]
  ratings            Rating[]
  financialDocuments FinancialDocument[]
  pickupRequests     PickupRequest[]
  kycDocuments       KycDocument[]
  kycDecisions       KycDecision[]
}

enum KycDocumentType {
  IDENTITY
  REGISTRATION
  VEHICLE
  OTHER
}

model KycDocument {
  id          BigInt          @id @default(autoincrement())
  trackingId  String          @unique @default(uuid())
  createdAt   DateTime        @default(now())
  type        KycDocumentType
  fileName    String
  mimeType    String
  size        Int
  content     Bytes
  uploadedBy  String
  collectorId BigInt
  collector   Collector       @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@index([collectorId, createdAt])
}

model KycDecision {
  id          BigInt    @id @default(autoincrement())
  trackingId  String    @unique @default(uuid())
  createdAt   DateTime  @default(now())
  status      KycStatus
  reason      String
  decidedBy   String
  collectorId BigInt
  collector   Collector @relation(fields: [collectorId], references: [id], onDelete: Cascade)

  @@index([collectorId, createdAt])
}

enum PickupRequestStatus {
  NEW
  SCHEDULED
  COMPLETED
  CANCELLED
}

model PickupRequest {
  id                 BigInt              @id @default(autoincrement())
  trackingId         String              @unique @default(uuid())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  status             PickupRequestStatus @default(NEW)
  wasteType          String
  addressText        String
  latitude           Float?
  longitude          Float?
  preferredDate      DateTime?
  scheduledDate      DateTime?
  completedAt        DateTime?
  estimatedPrice     Float?
  finalPrice         Float?
  notes              String?
  cancellationReason String?
  userId             BigInt
  user               User                @relation(fields: [userId], references: [id])
  collectorId        BigInt
  collector          Collector           @relation(fields: [collectorId], references: [id])
}

model Subscription {
  id         BigInt   @id @default(autoincrement())
  trackingId String   @unique @default(uuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  qrCodeId String

  gpsLocation Unsupported("geography(Point,4326)")

  addressText String

  status          SubscriptionStatus
  startDate       DateTime
  nextBillingDate DateTime

  userId  BigInt
  offerId BigInt

  user             User              @relation(fields: [userId], references: [id])
  offer            Offer             @relation(fields: [offerId], references: [id])
  collectionEvents CollectionEvent[]
  transactions     Transaction[]
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  PENDING_PAYMENT
}

enum TourStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Tour {
  id               BigInt            @id @default(autoincrement())
  trackingId       String            @unique @default(uuid())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  reference        String            @unique
  scheduledDate    DateTime
  actualStartTime  DateTime?
  actualEndTime    DateTime?
  status           TourStatus        @default(PLANNED)
  vehicleId        BigInt
  vehicle          Vehicle           @relation(fields: [vehicleId], references: [id])
  collectionEvents CollectionEvent[]
}

enum CollectionStatus {
  PENDING
  VALIDATED
  DISPUTED
  CANCELLED
}

enum DisputeStatus {
  OPEN
  IN_REVIEW
  RESOLVED
}

enum DisputeDecision {
  USER_FAVORED
  COLLECTOR_FAVORED
  INCONCLUSIVE
}

enum DisputeMeasure {
  NONE
  WARNING_COLLECTOR
  SUSPEND_COLLECTOR
}

enum DisputeHistoryAction {
  OPENED
  REVIEW_STARTED
  RESOLVED
}

model CollectionEvent {
  id                     BigInt                                @id @default(autoincrement())
  trackingId             String                                @unique @default(uuid())
  createdAt              DateTime                              @default(now())
  updatedAt              DateTime                              @updatedAt
  status                 CollectionStatus                      @default(PENDING)
  executedAt             DateTime?
  gpsProof               Unsupported("geography(Point,4326)")?
  photoUrl               String?
  qrScanData             String?
  autoValidationDeadline DateTime?
  disputeReason          String?
  tourId                 BigInt
  tour                   Tour                                  @relation(fields: [tourId], references: [id])
  subscriptionId         BigInt
  subscription           Subscription                          @relation(fields: [subscriptionId], references: [id])
  rating                 Rating?
  disputeCase            DisputeCase?
}

model DisputeCase {
  id                BigInt           @id @default(autoincrement())
  trackingId        String           @unique @default(uuid())
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  status            DisputeStatus    @default(OPEN)
  decision          DisputeDecision?
  resolutionReason  String?
  measure           DisputeMeasure   @default(NONE)
  assignedTo        String?
  resolvedBy        String?
  resolvedAt        DateTime?
  collectionEventId BigInt           @unique
  collectionEvent   CollectionEvent  @relation(fields: [collectionEventId], references: [id], onDelete: Cascade)
  history           DisputeHistory[]

  @@index([status, createdAt])
}

model DisputeHistory {
  id              BigInt               @id @default(autoincrement())
  trackingId      String               @unique @default(uuid())
  createdAt       DateTime             @default(now())
  action          DisputeHistoryAction
  fromStatus      DisputeStatus?
  toStatus        DisputeStatus
  decision        DisputeDecision?
  reason          String?
  measure         DisputeMeasure?
  actorTrackingId String
  disputeCaseId   BigInt
  disputeCase     DisputeCase          @relation(fields: [disputeCaseId], references: [id], onDelete: Cascade)

  @@index([disputeCaseId, createdAt])
}

model Rating {
  id                BigInt          @id @default(autoincrement())
  trackingId        String          @unique @default(uuid())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  score             Int
  comment           String?
  collectorId       BigInt
  collector         Collector       @relation(fields: [collectorId], references: [id])
  userId            BigInt
  user              User            @relation(fields: [userId], references: [id])
  collectionEventId BigInt          @unique
  collectionEvent   CollectionEvent @relation(fields: [collectionEventId], references: [id])
}

model Transaction {
  id                  BigInt              @id @default(autoincrement())
  trackingId          String              @unique @default(uuid())
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  amount              Float
  platformCommission  Float
  paymentGatewayRef   String?
  status              String
  invoicePdfUrl       String?
  timestamp           DateTime            @default(now())
  subscriptionId      BigInt
  subscription        Subscription        @relation(fields: [subscriptionId], references: [id])
  financialDocumentId BigInt?
  financialDocument   FinancialDocument?  @relation(fields: [financialDocumentId], references: [id])
  bankStatementLines  BankStatementLine[]
}

enum BankStatementLineStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

model BankStatementLine {
  id            BigInt                  @id @default(autoincrement())
  trackingId    String                  @unique @default(uuid())
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  statementDate DateTime
  label         String
  amount        Float
  reference     String?
  source        String?
  status        BankStatementLineStatus @default(UNMATCHED)
  transactionId BigInt?
  transaction   Transaction?            @relation(fields: [transactionId], references: [id])
  matchedAt     DateTime?

  @@index([status, statementDate])
  @@index([reference])
}

enum FinancialDocumentType {
  PAYOUT
  COLLECTOR_SUBSCRIPTION
}

enum FinancialDocumentStatus {
  DRAFT
  PENDING
  PAID
  OVERDUE
  FAILED
  CANCELLED
}

model FinancialDocument {
  id           BigInt                  @id @default(autoincrement())
  trackingId   String                  @unique @default(uuid())
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  type         FinancialDocumentType
  status       FinancialDocumentStatus @default(PENDING)
  collectorId  BigInt
  collector    Collector               @relation(fields: [collectorId], references: [id])
  periodStart  DateTime
  periodEnd    DateTime
  amount       Float
  documentUrl  String?
  dueDate      DateTime?
  settledAt    DateTime?
  metadata     Json
  transactions Transaction[]
}

enum CommunicationChannel {
  SMS
  EMAIL
  PUSH
}

enum CommunicationCampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  CANCELLED
}

model MessageTemplate {
  id         BigInt                  @id @default(autoincrement())
  trackingId String                  @unique @default(uuid())
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  name       String
  channel    CommunicationChannel
  language   String                  @default("fr")
  subject    String?
  content    String
  isActive   Boolean                 @default(true)
  campaigns  CommunicationCampaign[]
}

model CommunicationCampaign {
  id              BigInt                      @id @default(autoincrement())
  trackingId      String                      @unique @default(uuid())
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  name            String
  channel         CommunicationChannel
  audience        String
  status          CommunicationCampaignStatus @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  templateId      BigInt?
  template        MessageTemplate?            @relation(fields: [templateId], references: [id])
  messageSnapshot String
}
