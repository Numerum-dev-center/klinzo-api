generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN_SAAS
  GESTIONNAIRE_SAAS
  SUPPORT_SAAS
  ADMIN_COLLECTEUR
  AGENT_COLLECTEUR
  USAGER
}

model User {
  id            BigInt   @id @default(autoincrement())
  trackingId    String   @unique @default(uuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  firstName     String
  lastName      String
  email         String   @unique
  emailVerified Boolean  @default(false)
  phone         String
  password      String
  hashedRefreshToken String?
  role          Role     @default(USAGER)
  isActive      Boolean  @default(true)
  collectorId   BigInt?
  collector     Collector? @relation(fields: [collectorId], references: [id])
  subscriptions Subscription[]
}

enum KycStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum CollectorType {
  INDIVIDUAL
  COMPANY
  MUNICIPALITY
  ASSOCIATION
}

model Vehicle {
  id                 BigInt     @id @default(autoincrement())
  trackingId         String     @unique @default(uuid())
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  matricule          String     @unique
  licensePlate       String
  type               String
  capacity           Int
  isActive           Boolean    @default(true)
  collectorId        BigInt
  collector          Collector  @relation(fields: [collectorId], references: [id])
}

model Zone {
  id               BigInt     @id @default(autoincrement())
  trackingId       String     @unique @default(uuid())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  name             String
  city             String
  polygonPostgis   Unsupported("geometry(Polygon, 4326)")?
  isActive         Boolean    @default(true)
  collectorZones   CollectorZone[]
  offers           Offer[]
}

model CollectorZone {
  collectorId BigInt
  zoneId      BigInt
  collector   Collector @relation(fields: [collectorId], references: [id])
  zone        Zone      @relation(fields: [zoneId], references: [id])
  assignedAt  DateTime  @default(now())

  @@id([collectorId, zoneId])
}

model Offer {
  id               BigInt     @id @default(autoincrement())
  trackingId       String     @unique @default(uuid())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  name             String
  price            Float
  frequency        String
  wasteType        String
  isActive         Boolean    @default(true)
  collectorId      BigInt
  collector        Collector  @relation(fields: [collectorId], references: [id])
  zoneId           BigInt
  zone             Zone       @relation(fields: [zoneId], references: [id])
  subscriptions    Subscription[]
}

model Collector {
  id                 BigInt        @id @default(autoincrement())
  trackingId         String        @unique @default(uuid())
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  companyName        String
  registrationNumber String
  contactEmail       String
  contactPhone       String
  type               CollectorType
  adresse            String
  kycStatus          KycStatus     @default(PENDING_REVIEW)
  ratingAverage      Float         @default(0.0)
  payoutAccount      String?
  isActive           Boolean       @default(true)
  users              User[]
  vehicles           Vehicle[]
  collectorZones     CollectorZone[]
  offers             Offer[]
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PENDING_PAYMENT
}

model Subscription {
  id               BigInt     @id @default(autoincrement())
  trackingId       String     @unique @default(uuid())
  qrCodeId         String     @unique
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  gpsLocation      Unsupported("geometry(Point, 4326)")?
  addressText      String
  status           SubscriptionStatus @default(PENDING_PAYMENT)
  startDate        DateTime   @default(now())
  nextBillingDate  DateTime?
  userId           BigInt
  user             User       @relation(fields: [userId], references: [id])
  offerId          BigInt
  offer            Offer      @relation(fields: [offerId], references: [id])
}
