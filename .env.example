PGADMIN_EMAIL=admin@saas-dechets.com
PGADMIN_PASSWORD=change_me
JWT_SECRET=change_me_use_openssl_rand_hex_64
JWT_REFRESH_SECRET=change_me_use_openssl_rand_hex_64
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
SUPER_ADMIN_EMAIL=admin@votre-domaine.com
SUPER_ADMIN_PASSWORD=ChangeMe123!
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
FRONTEND_URL=http://localhost:5173

# Yeria super-app integration (https://yeria.app)
# Generate Ed25519 key pair: openssl genpkey -algorithm ed25519 | tee private.pem && openssl pkey -in private.pem -pubout | tee public.pem
# Then encode newlines: awk '{printf "%s\\n", $0}' private.pem
YERIA_PRIVATE_KEY=
YERIA_PUBLIC_KEY=
# Service IDs registered on the Yeria platform portal
YERIA_PUBLIC_SERVICE_ID=klinzo
YERIA_AGENT_SERVICE_ID=klinzo-agent
# Base URL of the Yeria platform (for JWT verification, notifications, user details)
YERIA_PLATFORM_URL=https://yeria.app
SWAGGER_ENABLED=true
