# --- VARIABLES POUR DOCKER (Création de la BDD) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=gestion_dechets

# --- VARIABLE POUR PRISMA (Connexion de l'API NestJS) ---
DATABASE_URL="postgresql://postgres:change_me_postgres_password@localhost:5435/gestion_dechets?schema=public"

# --- VARIABLES POUR PGADMIN (Interface Web BDD) ---
PGADMIN_EMAIL=admin@saas-dechets.com
PGADMIN_PASSWORD=change_me_pgadmin_password

# --- VARIABLES JWT (Authentification) ---
JWT_SECRET=remplacez_par_un_secret_long_d_au_moins_32_caracteres
JWT_REFRESH_SECRET=remplacez_par_un_autre_secret_long_d_au_moins_32_caracteres
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# --- VARIABLES SECURITE HTTP ---
NODE_ENV=development
PORT=4000
# Obligatoire en production, séparé par virgules si plusieurs origines.
CORS_ORIGIN=http://localhost:5173
# Swagger reste activé hors production. Mettre true pour l'activer explicitement en production.
SWAGGER_ENABLED=false

# --- PARAMETRES METIERS ---
# Taux décimal entre 0 et 1. 0.15 = 15%.
PLATFORM_COMMISSION_RATE=0.15
# Délai avant auto-validation d'une collecte en attente.
COLLECTION_AUTO_VALIDATION_HOURS=48
# Nombre de jours entre fin de période et échéance de facture collecteur.
COLLECTOR_INVOICE_DUE_DAYS=15

# --- VARIABLES D'INITIALISATION DU SYSTEME ---
SUPER_ADMIN_EMAIL=admin@votre-saas.com
SUPER_ADMIN_PASSWORD=MotDePasseTresSecurise123!

# --- CONFIGURATION YERIA ---
# Utilisez des clés PEM Ed25519; les retours ligne peuvent être encodés avec \n.
YERIA_PRIVATE_KEY=
YERIA_PUBLIC_KEY=
BACKEND_URL=http://localhost:4000
